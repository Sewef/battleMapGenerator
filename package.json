{
  "name": "battlemap-generator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "build": "npm run typecheck && vite build --configLoader runner",
    "test:generation": "vite build --configLoader runner --ssr src/generation/generation-test.ts --outDir .test-dist/generation-test --emptyOutDir && node .test-dist/generation-test/generation-test.js",
    "preview": "vite preview --configLoader runner",
    "types:worker": "wrangler types worker/worker-configuration.d.ts --include-runtime=false",
    "deploy:check": "wrangler types worker/worker-configuration.d.ts --include-runtime=false --check && npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "d3-delaunay": "^6.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "wrangler": "^4.117.0"
  }
}
